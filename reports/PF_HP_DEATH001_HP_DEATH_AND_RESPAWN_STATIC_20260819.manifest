# Evidence for PF_HP_DEATH001 (paths relative to the Pirate Force root)
# Static RE only: no src/ change, no ledger entry, no scenario, no runtime claim,
# no network, no GameClient launch, no canonical database access.  The single
# matrix edit this milestone makes is the one row it reports on, and it is listed
# below as a modified-but-unpinned file.
# Every address, vtable slot, mask bit, literal and count quoted in the report is
# reproduced from these exact files by tools/pf_hp_death_respawn_static.py
# (191 guards; exit 0 = PASS).  Measured at HEAD fc204c7.
#
# --- THE SOLE BINARY EVIDENCE (read-only, never written by this project) ---
# The whole HP / death / respawn reconstruction comes out of this one image:
#   HP wire fields          BasicAttr::Serialize 0x4656F0
#                             bit 0x0004 -> u32 +0x44 (HP current)  gate 0x46574A
#                             bit 0x0008 -> u32 +0x48 (HP max)      gate 0x46575E
#                             bit 0x0010 -> u32 +0x4C / 0x0020 -> +0x50 (MP pair)
#                             bit 0x0080 -> f32 +0x58 (death/down timer) gate 0x4657AE
#                           ActorAttr alternate pair, high mask +0x1B8
#                             bit 0x40 -> u32 +0x1A8  gate 0x4666D7
#                             bit 0x80 -> u32 +0x1AC  gate 0x4666F2
#   current-vs-max consumer HUD updater 0x53F180 -> bar helper 0x53EED0
#                           (arg1/arg0, arg1 is the printed number => +0x44 current)
#   pair selector           byte [actor+0x358], sole writer 0x4564B3
#                           (`al = SceneCategory(0x430E10) == 8`)
#   DEATH PREDICATES        CNetActor/CMyActor vtable +0x40 -> 0x454AC0
#                                              vtable +0x3C -> 0x454A70
#                                              vtable +0x74 -> 0x44C630 (GetAttr)
#                           CNetNPC/CAvatarNPC/Pet   +0x40 -> 0x43BDA0
#                                                    +0x3C -> 0x43BD70
#                                                    +0x74 -> 0x45CD20
#                           float constant 0xF0989C == 0.0f
#   death transition        0x4446F0 = call 0x5DF080 (attr apply) + call 0x4437C0
#                           0x4437C0 sole call site 0x444705, latches [actor+0x70]|=0x200
#                           CActorTask_Dead ctor 0x472810 (sole call site 0x4439E9),
#                           vtable 0xF0F048, task id 0x80000005,
#                           update 0x472850 plays L"_F_DIE_000" at 0xF0F060
#   local-player death UI   CMyActor vtable +0x18 -> 0x44E4E0 -> 0x44A540 (0x44E828)
#                           opens L"Main_Dead" 0xF0D738 via 0xAA0710 at 0x44A5A1
#   verb family (3 of 519)  ReliveVital                0x1AD4 thunk 0xBEE640
#                             slot 0x1082038 getid 0x5E5F70 vtable 0xF30404
#                             sizeof 0x1C ser 0x5E5F80 inbound 0x710440 = NONE
#                           ReliveMarkerVital          0x3DD6 thunk 0xBEE660
#                             slot 0x108203C getid 0x5E7440 vtable 0xF305D8
#                             sizeof 0x18 ser 0x5EB6D0 inbound 0x5F0410
#                           Pets_NotifySailorDeadVital 0x8B12 thunk 0xC04410
#                             slot 0x1088364 getid 0x6FF0B0 vtable 0xF422BC
#                             sizeof 0x20 ser 0x642B00 inbound 0x700DC0
#   ReliveVital producers   pool 0x4E45B0; +0x14=1 at 0x4E4737, +0x14=0 at 0x4E4AEA
#                           and 0x4E4B8A; sends via 0x4011A0 -> 0x5DD800
#   respawn marker          handler 0x5F0410 stores into CMyActor+0x400;
#                           only other reader 0x4E4370 (sole caller 0x4E4BBA);
#                           marker sub-object serializer 0x5DF250;
#                           marker u16 +0x12 used as a scene id against
#                           L"SCENE_NAME_TIP" 0xF0C59C / L"s_SCENE_NAME" 0xF0C3C4
#   death penalty (display) L"STANDARD_STATUS" 0xF152AC column L"n_DEADLOSS" 0xF14BC8
#                           read at 0x4E4C54 and 0x4E4C9F, keyed by BasicAttr+0x5E
#   UI wiring               ReliveConfirmEventHandler vtable 0xF2E6A8
#                             +0x18 bind 0x4E43A0, +0x28 dispatch 0x4E4D90
#                             L"BUTTON_RELIVE" 0xF1A704 / L"BUTTON_SPAWN" 0xF1A6E8
#                             L"BUTTON_RELIVE_TEXT" 0xF1A6C0
#                           MainDeadEventHandler vtable 0xF1F550
#                             +0x60 bind 0x5183D0 (L"BUTTON_DIE" 0xF1F5CC)
#                             +0x18 hook 0x5184C0 -> 0x518450, action id 0xEA7C
#   RTTI descriptors        .?AVReliveVital@@ 0x101FB00, .?AVReliveMarkerVital@@
#                           0x101FB1C, .?AVPets_NotifySailorDeadVital@@ 0x101D82C,
#                           .?AVCActorTask_Dead@@ 0x101CDE4,
#                           .?AVReliveConfirmEventHandler@@ 0x10232EC,
#                           .?AVMainDeadEventHandler@@ 0x1023E60
